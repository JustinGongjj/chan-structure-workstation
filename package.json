{
  "name": "chan-structure-workstation",
  "version": "2.3.0",
  "description": "缠论工作站 · 零依赖 Node.js 的缠论（Chan Theory）技术分析平台：六市场实时行情、笔/线段/中枢/背驰/买卖点、手绘线 AI 复核、算卦择时、108 关闯关游戏",
  "keywords": [
    "chanlun",
    "缠论",
    "technical-analysis",
    "stock",
    "futures",
    "crypto",
    "zero-dependency",
    "nodejs",
    "canvas",
    "trading"
  ],
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "main": "server/index.js",
  "files": [
    "server",
    "web",
    "docs",
    "space",
    "data",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "PORT=8931 node server/index.js",
    "test": "node --test test/*.test.js",
    "lint": "find server web -name '*.js' -exec node --check {} +",
    "docker": "docker build -t chan-station . && docker run --rm -p 8931:8931 chan-station",
    "check:api": "node scripts/apicheck.js",
    "check:ui": "node scripts/uicheck.js",
    "check:flow": "node scripts/flowcheck.js",
    "check:all": "node --test test/*.test.js && node scripts/htmlcheck.js && node scripts/cssaudit.js && node scripts/apicheck.js && node scripts/uicheck.js && node scripts/sheetcheck.js && node scripts/flowcheck.js && node scripts/perfcheck.js",
    "check:sheet": "node scripts/sheetcheck.js",
    "check:css": "node scripts/cssaudit.js",
    "check:perf": "node scripts/perfcheck.js",
    "check:pivot": "node scripts/pivotviz.js",
    "check:matrix": "node scripts/matrixcheck.js",
    "check:sources": "node scripts/srcaudit.js",
    "check:html": "node scripts/htmlcheck.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinGongjj/chan-structure-workstation.git"
  },
  "bugs": {
    "url": "https://github.com/JustinGongjj/chan-structure-workstation/issues"
  },
  "homepage": "https://github.com/JustinGongjj/chan-structure-workstation#readme",
  "author": {
    "name": "JustinGongjj",
    "url": "https://github.com/JustinGongjj"
  }
}
